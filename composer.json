{
    "name": "alcamo/rdf-literal-workbench",
    "description": "RDF literal creation and validation",
    "keywords": [ "datatype", "literal", "rdf", "factory" ],
    "license": "Apache-2.0",
    "require": {
        "php": "7.3 - 8.5",
        "alcamo/dom": "0.16 - 0.18"
    },
    "autoload": {
	"psr-4": {
	    "alcamo\\rdf_literal_workbench\\": "src/"
	}
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "3.*"
    },
    "scripts": {
        "test": [
            "phpunit tests",
            "phpcs --standard=PSR12 -p -s src",
            "phpcs --standard=PSR12 -p -s --exclude=PSR1.Classes.ClassDeclaration,PSR1.Files.SideEffects tests"
        ],
        "fix": [
            "phpcbf --standard=PSR12 -p -s src",
            "phpcbf --standard=PSR12 -p -s --exclude=PSR1.Classes.ClassDeclaration,PSR1.Files.SideEffects tests"
        ]
    }
}
